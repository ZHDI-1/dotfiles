[git]
    autoAdd = false
    autoCommit = false
    autoPush = false

[hooks.edit.pre]
    command = "python3"
    args = ["{{ .chezmoi.sourceDir }}/scripts/chezmoi-edit-git.py", "pre"]

[hooks.edit.post]
    command = "python3"
    args = ["{{ .chezmoi.sourceDir }}/scripts/chezmoi-edit-git.py", "post"]

[data]
    tmuxRole = {{ promptChoiceOnce . "tmuxRole" "tmux role" (list "client" "remote") | quote }}
    gitName = {{ promptStringOnce . "gitName" "Git user name" | quote }}
    gitEmail = {{ promptStringOnce . "gitEmail" "Git email" | quote }}
    githubUseProxy = {{ promptBoolOnce . "githubUseProxy" "Use an explicit proxy for GitHub SSH (no for TUN/direct access)" true }}
