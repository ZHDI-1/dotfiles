[font]
# normal = { family = "CodeNewRoman Nerd Font", style = "Regular" }
normal = { family = "GoogleSansCode Nerd Font", style = "Regular" }
# normal = { family = "Code New Roman", style = "Regular" }
bold_italic = { style = "Bold Italic" }
size = 15.0
offset = { x = 1, y = 4}

[window]
startup_mode = "Maximized"
opacity = 0.80
# opacity = 0.30
{{ if eq .chezmoi.os "darwin" -}}
decorations = "buttonless"
decorations_theme_variant = 'Dark'
option_as_alt = "Both"
# blur = false
blur = true
{{ end -}}

[scrolling]
history = 10000

[mouse]
hide_when_typing = true

[terminal]
osc52 = "CopyPaste"

[colors]
cursor = { text = "0x282829", cursor = "0x928374" }

[colors.primary]
background = "0x282829"
foreground = "0xebdbb2"

[colors.normal]
black = "0x665c54"
red = "0xcc241d"
green = "0x98971a"
yellow = "0xd79921"
blue = "0x458588"
magenta = "0xb16286"
cyan = "0x689d6a"
white = "0xa89984"

[colors.bright]
black = "0x7c6f64"
red = "0xfb4934"
green = "0xb8bb26"
yellow = "0xfabd2f"
blue = "0x83a598"
magenta = "0xd3869b"
cyan = "0x8ec07c"
white = "0xbdae93"

[colors.selection]
text = "0x928374"
background = "0xebdbb2"

[colors.search.matches]
foreground = "0x928374"
background = "0xebdbb2"

[colors.hints.start]
foreground = "0x282829"
background = "0x83a598"

[colors.hints.end]
foreground = "0x282829"
background = "0x83a598"

[colors.line_indicator]
foreground = "None"
background = "None"

[colors.footer_bar]
background = "0x665c54"
foreground = "0xfbf1c7"

[colors.vi_mode_cursor]
text = "0x282829"
cursor = "0x928374"

[selection]
save_to_clipboard = true

