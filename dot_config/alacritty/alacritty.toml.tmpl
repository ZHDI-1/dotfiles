[[keyboard.bindings]]
key = "N"
mods = "Command"
action = "None"
[[keyboard.bindings]]
key = "H"
mods = "Command"
action = "None"
[[keyboard.bindings]]
key = "H"
mods = "Command|Shift"
action = "None"
[[keyboard.bindings]]
key = "H"
mods = "Command|Option"
action = "None"
[env]
TERM = "xterm-256color"
