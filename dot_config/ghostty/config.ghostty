# Ported from ~/.config/alacritty/alacritty.toml

# Font
font-family = "GoogleSansCode Nerd Font"
font-style = Regular
font-style-bold-italic = "Bold Italic"
font-size = 15
adjust-cell-width = 1
adjust-cell-height = 4

# Window
maximize = true
background-opacity = 0.80
background-opacity-cells = true
background-blur = true
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true
scrollback-limit = 10000

# Shell
command = /opt/homebrew/bin/tmux new-session -A
term = xterm-ghostty
progress-style = true

# Colors
background = #282829
foreground = #ebdbb2
cursor-color = #928374
cursor-text = #282829
selection-foreground = #928374
selection-background = #ebdbb2
search-foreground = #928374
search-background = #ebdbb2

palette = 0=#665c54
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#7c6f64
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#bdae93

# Selection
copy-on-select = clipboard
clipboard-write = allow
clipboard-read = allow

# Keybindings
keybind = clear
keybind = copy=copy_to_clipboard:mixed
keybind = paste=paste_from_clipboard
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+shift+v=paste_from_selection
keybind = super+q=quit
