export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

typeset -U path PATH

path=(
  "${HOME}/.local/bin"
  "${HOME}/.cargo/bin"
  "${HOME}/go/bin"
  "${HOME}/perl5/bin"
  "${HOME}/.antigravity/antigravity/bin"
  $path
)

{{ if eq .chezmoi.os "darwin" -}}
export SWIFTLY_HOME_DIR="${HOME}/.swiftly"
export SWIFTLY_BIN_DIR="${HOME}/.swiftly/bin"

export LDFLAGS="-L/opt/homebrew/opt/llvm/lib -L/opt/homebrew/Cellar/openssl@3/3.3.1/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include -I/opt/homebrew/Cellar/openssl@3/3.3.1/include"

path=(
  "/opt/homebrew/opt/curl/bin"
  "/opt/homebrew/opt/rustup/bin"
  "/opt/homebrew/opt/llvm/bin"
  "/opt/homebrew/opt/make/libexec/gnubin"
  "/opt/homebrew/opt/grep/libexec/gnubin"
  "/Library/Frameworks/Python.framework/Versions/3.10/bin"
  "${HOME}/Library/Android/sdk/cmdline-tools/latest/bin"
  "${HOME}/Library/Application Support/JetBrains/Toolbox/scripts"
  "/opt/custom/bin"
  $path
)
{{ else -}}
path=(
  "${HOME}/.local/bin"
  "${HOME}/.cargo/bin"
  "${HOME}/go/bin"
  "${HOME}/perl5/bin"
  "${HOME}/.antigravity/antigravity/bin"
  $path
)
{{ end -}}

export PATH

export VISUAL="nvim"
export EDITOR="${VISUAL}"
export MANPAGER="nvim +Man!"
export MANWIDTH=999

export _ZO_EXCLUDE_DIRS="${HOME}:${HOME}/Downloads:${HOME}/Application:${HOME}/Desktop:${HOME}/Documents:${HOME}/Movies:${HOME}/Music:/Application:${HOME}/Library"

export PERL5LIB="/Users/zhdi/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
export PERL_LOCAL_LIB_ROOT="/Users/zhdi/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"
export PERL_MB_OPT="--install_base \"/Users/zhdi/perl5\""
export PERL_MM_OPT="INSTALL_BASE=/Users/zhdi/perl5"

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell zsh)"
fi
