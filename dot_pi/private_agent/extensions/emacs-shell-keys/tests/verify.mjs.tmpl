// Exercise real Pi input routing and original overlay handlers with a fake PTY.
// No shell, agent, network request, or live terminal is started.
function inputFixture(focused = null, mode = 'tui', focusInspection = true) {
  const events = new Map(), widgets = new Map(), listeners = new Set();
  function renderer(Class = tui.TuiMainScreen) {
    const view = new Class({ rows: 30, columns: 100, write() {}, hideCursor() {} });
    view.requestRender = () => {};
    view.requestImmediateRender = () => {};
    return view;
  }
  let view = renderer();
  view.setFocus(focused);
  const liveTui = focusInspection ? createInteractiveTuiReference(() => view) : {};
  const ctx = {
    mode, hasUI: mode === 'tui' || mode === 'rpc',
    ui: {
      setWidget(key, factory, options) {
        widgets.get(key)?.component.dispose?.();
        widgets.delete(key);
        if (factory) widgets.set(key, { component: factory(liveTui, {}), options });
      },
      onTerminalInput(handler) {
        listeners.add(handler);
        let off = view.addInputListener(handler);
        return () => { off(); view.removeInputListener(handler); listeners.delete(handler); };
      },
    },
  };
  install({ on(event, handler) { events.set(event, handler); } });
  const f = {
    ctx, events, widgets, listeners,
    send(data) { view.handleTerminalInput(data); },
    focus(component) { view.setFocus(component); },
    start() { events.get('session_start')({ reason: 'startup' }, ctx); },
    stop() { events.get('session_shutdown')({ reason: 'quit' }, ctx); },
    switchRenderer() {
      const target = view.getFocusedComponent();
      for (const handler of listeners) view.removeInputListener(handler);
      view = renderer(tui.TuiAltScreen);
      view.setFocus(target);
      for (const handler of listeners) view.addInputListener(handler);
    },
  };
  f.start();
  return f;
}
function overlayFixture(Class, state = 'running') {
  const writes = [], actions = [];
  const overlay = Object.create(Class.prototype);
  Object.defineProperty(overlay, 'session', { value: {
    exited: state === 'exited', rows: 20,
    write(data) { writes.push(data); },
    scrollUp() { actions.push('scroll-up'); },
    scrollDown() { actions.push('scroll-down'); },
  } });
  Object.assign(overlay, {
    state, userTookOver: false,
    config: { focusShortcut: 'alt+shift+f' },
    options: { onUnfocus() { actions.push('unfocus'); } },
    tui: { requestRender() {} },
    triggerUserTakeover() { this.state = 'running'; this.userTookOver = true; actions.push('takeover'); },
    returnToHandsFree() { actions.push('monitor'); },
    finishWithBackground() { actions.push('background'); },
    finishWithTransfer() { actions.push('transfer'); },
    finishWithExit() { actions.push('exit'); },
    finishAndClose() { actions.push('exit'); },
  });
  return { overlay, writes, actions, ...inputFixture(overlay) };
}

for (const Class of [InteractiveShellOverlay, ReattachOverlay]) {
  for (const data of ['\x02', '\x1b[98;5u', '\x1b[27;5;98~', '\x1b[98;5:1u', '\x1b[98;5:2u']) {
    test(`${Class.name}: Ctrl+B ${JSON.stringify(data)} becomes Left Arrow`, () => {
      const f = overlayFixture(Class);
      f.send(data);
      assert.deepEqual(f.writes, ['\x1b[D']);
      assert.deepEqual(f.actions, []);
      f.stop();
    });
  }
  test(`${Class.name}: Ctrl+B release does not move or background`, () => {
    const f = overlayFixture(Class);
    f.send('\x1b[98;5:3u');
    assert.deepEqual(f.writes, []);
    assert.deepEqual(f.actions, []);
    f.stop();
  });
  test(`${Class.name}: other keys and bracketed paste reach PTY unchanged`, () => {
    const f = overlayFixture(Class);
    const inputs = ['\x06', '\x10', '\x0e', '\x0a', '\r', '\x1b[13;2u',
      '\x1b[98;6u', '\x1bb', '\x1b[98;7u', '\x1b[D', '\x1b[200~a\x02b\x1b[201~'];
    for (const data of inputs) f.send(data);
    assert.deepEqual(f.writes, inputs);
    assert.deepEqual(f.actions, []);
    f.stop();
  });
  test(`${Class.name}: underlying source still backgrounds without the override`, () => {
    const f = overlayFixture(Class);
    f.stop();
    f.send('\x02');
    assert.deepEqual(f.actions, ['background']);
    assert.deepEqual(f.writes, []);
  });
  test(`${Class.name}: live TUI reference survives switch to fullscreen`, () => {
    const f = overlayFixture(Class);
    f.switchRenderer();
    f.send('\x02');
    assert.deepEqual(f.writes, ['\x1b[D']);
    assert.deepEqual(f.actions, []);
    f.stop();
    assert.equal(f.listeners.size, 0);
  });
  test(`${Class.name}: Ctrl+Q menu still backgrounds`, () => {
    const f = overlayFixture(Class);
    f.send('\x11');
    assert.equal(f.overlay.state, 'detach-dialog');
    f.send('\x02'); // Still ignored inside the detach menu.
    f.send('\x1b[B');
    assert.equal(f.overlay.dialogSelection, 'background');
    f.send('\r');
    assert.deepEqual(f.actions, ['background']);
    assert.deepEqual(f.writes, []);
    f.stop();
  });
  test(`${Class.name}: transfer, scroll, menu cancellation unchanged`, () => {
    const f = overlayFixture(Class);
    f.send('\x1b[1;2A');
    f.send('\x1b[1;2B');
    f.send('\x11');
    f.send('\x1b');
    assert.equal(f.overlay.state, 'running');
    f.send('\x14');
    assert.deepEqual(f.actions, ['scroll-up', 'scroll-down', 'transfer']);
    f.stop();
  });
}

