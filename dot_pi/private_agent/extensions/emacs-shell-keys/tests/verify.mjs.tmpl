test('No focus, ordinary dialogs and shell unfocus leave Ctrl+B unchanged', () => {
  const seen = [];
  const dialog = { handleInput(data) { seen.push(data); } };
  const f = overlayFixture(InteractiveShellOverlay);
  f.focus(null); f.send('\x02');
