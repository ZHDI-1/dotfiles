};
const bindings = KeybindingsManager.create('{{ .chezmoi.homeDir }}/.pi/agent');

test('Only requested keybinding overrides exist; all other effective bindings unchanged', () => {
  assert.deepEqual(JSON.parse(readFileSync('{{ .chezmoi.homeDir }}/.pi/agent/keybindings.json', 'utf8')), expected);
  const defaults = new KeybindingsManager().getEffectiveConfig();
  const current = bindings.getEffectiveConfig();
  for (const [action, keys] of Object.entries(defaults)) {
    if (!(action in expected)) assert.deepEqual(current[action], keys, action);
  }
  assert.equal(bindings.matches('\x10', 'app.model.cycleForward'), false);
  assert.equal(bindings.matches('\x02', 'tui.editor.cursorLeft'), true);
});

test('Menu navigation aliases do not trigger picker toggles', () => {
  assert.ok(bindings.matches('\x0e', 'tui.select.down'));
  assert.ok(bindings.matches('\x10', 'tui.select.up'));
  assert.ok(bindings.matches('\x1b[B', 'tui.select.down'));
  assert.ok(bindings.matches('\x1b[A', 'tui.select.up'));
  for (const action of ['app.session.toggleNamedFilter', 'app.session.togglePath', 'app.models.toggleProvider']) {
    assert.equal(bindings.matches('\x0e', action), false);
    assert.equal(bindings.matches('\x10', action), false);
  }
  assert.ok(bindings.matches('\x1bn', 'app.session.toggleNamedFilter'));
  assert.ok(bindings.matches('\x1bp', 'app.session.togglePath'));
  assert.ok(bindings.matches('\x1b\x10', 'app.models.toggleProvider'));
  assert.equal(bindings.matches('\x1b\x10', 'app.models.reorderUp'), false);
});

test('Native SelectList accepts Ctrl+N/P, arrows and enhanced terminal sequences', () => {
  tui.setKeybindings(bindings);
  const list = new tui.SelectList(['a', 'b', 'c'].map(value => ({ value, label: value })), 5, getSelectListTheme());
  for (const [down, up] of [['\x0e', '\x10'], ['\x1b[B', '\x1b[A'], ['\x1b[110;5u', '\x1b[112;5u']]) {
    list.setSelectedIndex(0);
    list.handleInput(down); assert.equal(list.getSelectedItem().value, 'b');
    list.handleInput(up); assert.equal(list.getSelectedItem().value, 'a');
  }
});

test('Native settings list moves selection without changing values until Enter', () => {
  tui.setKeybindings(bindings);
  const changes = [];
  const list = new tui.SettingsList(['a', 'b', 'c'].map(id => ({ id, label: id, currentValue: 'off', values: ['off', 'on'] })),
    5, getSettingsListTheme(), (...args) => changes.push(args), () => {});
  list.handleInput('\x0e'); assert.deepEqual(changes, []);
  list.handleInput('\r'); assert.deepEqual(changes, [['b', 'on']]);
  list.handleInput('\x10'); list.handleInput('\r');
  assert.deepEqual(changes, [['b', 'on'], ['a', 'on']]);
});

test('Native resume picker navigates with Ctrl+N/P; filters and path display use Alt', async () => {
  tui.setKeybindings(bindings);
  const sessions = ['a', 'b', 'c'].map((id, i) => ({
    id, path: `/nonexistent/pi-menu-test/${id}.jsonl`, cwd: '/nonexistent/pi-menu-test',
    created: new Date(3000 - i * 1000), modified: new Date(3000 - i * 1000),
    messageCount: 2, firstMessage: id, name: i === 0 ? 'Named session' : undefined,
  }));
  const loaded = Promise.resolve(sessions), chosen = [];
  const picker = new SessionSelectorComponent(() => loaded, () => loaded, path => chosen.push(path),
    () => {}, () => {}, () => {}, { keybindings: bindings });
  await loaded; // The constructor's loadScope continuation was registered first.
  picker.handleInput('\x0e'); picker.handleInput('\r');
  picker.handleInput('\x10'); picker.handleInput('\r');
  assert.deepEqual(chosen, [sessions[1].path, sessions[0].path]);
  assert.equal(picker.nameFilter, 'all'); assert.equal(picker.sessionList.showPath, false);
  picker.handleInput('\x1bn'); assert.equal(picker.nameFilter, 'named');
  picker.handleInput('\x1bp'); assert.equal(picker.sessionList.showPath, true);
});

test('Native scoped-model picker navigates without toggling providers; Ctrl+Alt+P toggles', () => {
  tui.setKeybindings(bindings);
  const changes = [];
  const allModels = ['a', 'b', 'c'].map(id => ({ id, name: id, provider: 'test', reasoning: false,
    api: 'openai-completions', baseUrl: 'http://invalid', input: ['text'], contextWindow: 8192, maxTokens: 1024,
    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }));
  const picker = new ScopedModelsSelectorComponent({ allModels, enabledModelIds: null }, {
    onChange: ids => changes.push(ids), onPersist: () => assert.fail('Unexpected settings save'), onCancel() {},
  });
  picker.handleInput('\x0e'); assert.equal(picker.selectedIndex, 1);
  picker.handleInput('\x10'); assert.equal(picker.selectedIndex, 0);
  assert.deepEqual(changes, []);
  picker.handleInput('\x1b\x10'); assert.deepEqual(changes, [[]]);
  picker.handleInput('\x1b\x10'); assert.deepEqual(changes, [[], null]);
});

function editorFixture(Class) {
  tui.setKeybindings(bindings);
  const terminal = { requestRender() {}, terminal: { rows: 30, columns: 100 } };
  const theme = { borderColor: s => s, selectList: {} };
  const options = {
    keybindings: bindings, isBashModeActive: () => false, isShellRunning: () => false,
    onExitBashMode() {}, onSubmitCommand() {}, onInterrupt() {}, onNotify() {},
    getHistoryEntries: () => [], areCompletionsEnabled: () => false,
    resolveGhostSuggestion: async () => null,
  };
  return new Class(terminal, theme, bindings, options);
}

for (const Class of [CustomEditor, BashModeEditor]) {
  test(`${Class.name}: raw override preserves Ctrl+B and Ctrl+P/N in the main prompt`, () => {
    const editor = editorFixture(Class);
    const f = inputFixture(editor);
    editor.onAction('app.model.cycleForward', () => assert.fail('cycled model'));
    editor.addToHistory('older');
    editor.setText('draft');
    f.send('\x02');
    assert.deepEqual(editor.getCursor(), { line: 0, col: 4 });
    f.send('\x10'); assert.equal(editor.getText(), 'older');
    f.send('\x0e'); assert.equal(editor.getText(), 'draft');
    f.stop();
  });
  test(`${Class.name}: Ctrl+P/N navigate an open completion menu instead of prompt history`, () => {
    const editor = editorFixture(Class);
    editor.addToHistory('older prompt'); editor.setText('/');
    editor.applyAutocompleteSuggestions({ prefix: '/', items: ['aa', 'bb', 'cc'].map(value => ({ value, label: value })) }, 'regular');
    editor.handleInput('\x0e'); assert.equal(editor.autocompleteList.getSelectedItem().value, 'bb');
    editor.handleInput('\x10'); assert.equal(editor.autocompleteList.getSelectedItem().value, 'aa');
    assert.equal(editor.getText(), '/');
  });
  test(`${Class.name}: Ctrl+P/N browse history and restore multiline draft`, () => {
    const editor = editorFixture(Class);
    editor.onAction('app.model.cycleForward', () => assert.fail('cycled model'));
    editor.addToHistory('first'); editor.addToHistory('second');
    editor.setText('draft\nmultiline');
    editor.handleInput('\x10'); assert.equal(editor.getText(), 'second');
    editor.handleInput('\x10'); assert.equal(editor.getText(), 'first');
    editor.handleInput('\x0e'); assert.equal(editor.getText(), 'second');
    editor.handleInput('\x0e'); assert.equal(editor.getText(), 'draft\nmultiline');
  });
  test(`${Class.name}: Ctrl+B remains cursor-left`, () => {
    const editor = editorFixture(Class);
    editor.setText('ab'); editor.handleInput('\x02');
    assert.deepEqual(editor.getCursor(), { line: 0, col: 1 });
  });
  for (const enhanced of [false, true]) {
    test(`${Class.name}: Shift+Enter/Ctrl+J newline and Enter submit (enhanced=${enhanced})`, () => {
      tui.setKittyProtocolActive(enhanced);
      const editor = editorFixture(Class);
      const submissions = [];
      editor.onSubmit = text => submissions.push(text);
      editor.setText('a');
      editor.handleInput('\x0a');
      assert.equal(editor.getText(), 'a\n');
      editor.handleInput('\x1b[13;2u');
      assert.equal(editor.getText(), 'a\n\n');
      editor.handleInput('b');
      assert.deepEqual(submissions, []);
      editor.handleInput('\r');
      assert.deepEqual(submissions, ['a\n\nb']);
      tui.setKittyProtocolActive(false);
    });
  }
}
