test('Widget is invisible; repeated startup and shutdown do not leak input listeners', () => {
  const f = inputFixture();
  for (let i = 0; i < 3; i++) {
    f.start();
    assert.equal(f.listeners.size, 1);
    assert.equal(f.widgets.size, 1);
    const widget = [...f.widgets.values()][0];
    assert.equal(widget.options.placement, 'belowEditor');
    assert.deepEqual(widget.component.render(80), []);
    assert.equal(widget.component.handleInput, undefined);
  }
  f.stop(); f.stop();
  assert.equal(f.listeners.size, 0);
  assert.equal(f.widgets.size, 0);
});

