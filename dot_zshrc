# zmodload zsh/zprof

# Some tools launch zsh with -i/-l but without a real terminal. Skip prompt and
# line-editor setup there to avoid non-tty errors and broken tmux attach flows.
if [[ ! -o interactive ]] || [[ ! -t 0 ]] || [[ ! -t 1 ]]; then
  return 0
fi

# Powerlevel10k instant prompt is disabled. Do not source its cached preamble,
# otherwise it can still alter tty state before ~/.p10k.zsh is loaded.

if [[ -r "${HOME}/.config/zsh/plugins.zsh" ]]; then
  source "${HOME}/.config/zsh/plugins.zsh"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

if [[ -r "${HOME}/.config/zsh/interactive.zsh" ]]; then
  source "${HOME}/.config/zsh/interactive.zsh"
fi

if [[ -r "${HOME}/.config/zsh/aliases.zsh" ]]; then
  source "${HOME}/.config/zsh/aliases.zsh"
fi
